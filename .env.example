GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GITHUB_TOKEN=your_github_token_here
# The separate GitOps repo NL2Infra opens pull requests against (owner/name). See docs/gitops.md.
MANIFESTS_REPO=your-username/nl2infra-manifests
MODEL_NAME=llama3-70b-8192
# MODEL_NAME=gemini-1.5-pro
MOCK_MODE=true

# Where the in-dashboard notification feed is stored (JSONL). Optional.
NL2INFRA_EVENTS_FILE=events.jsonl

# Slack PR approvals. Copy these from your Slack app settings; keep real values in .env only.
# Incoming Webhooks > Add New Webhook to Workspace (select #nl2infra).
SLACK_WEBHOOK_URL=paste_incoming_webhook_url_here
# Basic Information > App Credentials > Signing Secret.
SLACK_SIGNING_SECRET=paste_signing_secret_here
# Public HTTPS base URL for this FastAPI app (no path or trailing slash).
PUBLIC_BASE_URL=https://your-public-host.example

# Team sign-in: GitHub > Settings > Developer settings > OAuth Apps.
# Register the callback URL as PUBLIC_BASE_URL/auth/callback.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Optional separate origin for sign-in; use http://localhost:8000 for local development.
# Leave blank on deployment to use PUBLIC_BASE_URL.
NL2INFRA_AUTH_BASE_URL=
# Your numeric GitHub user ID (not username). Seeds admins in an EMPTY auth database only.
NL2INFRA_BOOTSTRAP_ADMIN_IDS=
# Persist this database on the server; never commit it.
NL2INFRA_AUTH_DB=data/auth.sqlite3
